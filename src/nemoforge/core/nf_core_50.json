{
  "meta": {
    "version": "1.0",
    "created": "2026-03-31",
    "description": "NemoForge Core 50 Benchmark — GENMANIP-inspired task suite for RAR loop evaluation",
    "taxonomy": {
      "Spatial Reasoning": 15,
      "Commonsense Reasoning": 15,
      "Long-horizon": 10,
      "Appearance-based": 10
    },
    "difficulty_distribution": { "Easy": 16, "Medium": 18, "Hard": 16 },
    "tosg_schema": {
      "note": "relations[] drives automatic success checking via physics report + pose_snapshot",
      "predicates": ["nextTo","onTopOf","inside","inFrontOf","behind","leftOf","rightOf","noCollision","stacked","aligned","withinReach","ordered","grouped"],
      "selection_predicates": ["byColor","bySize","byMaterial","byShape","byCondition"],
      "fields": {
        "subject": "name of the object being placed",
        "predicate": "spatial or functional relation",
        "object": "reference object or location",
        "threshold_cm": "distance tolerance for success (optional)",
        "required": "if false, relation is advisory only"
      }
    }
  },
